<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!--
		OIDC.Test configuration.
		These keys are the AppVision OIDC options (App.Main.Authentication.Oidc.*) without their prefix,
		so the values of a server configuration can be copied here 1:1.
		Issuer, Audience and ClientId (when no AccessToken is given) are prompted for when empty;
		the other keys are optional and keep the same defaults as the server.

		The defaults below point at the public Duende demo provider (https://demo.duendesoftware.com):
		public client "interactive.public" (authorization code + PKCE, any redirect URI accepted),
		users alice/alice and bob/bob, no groups. The "api" scope yields a JWT access token of audience "api"
		carrying the name and email claims.
		-->

		<!-- Issuer of the access tokens (iss claim), as published by the provider; HTTPS unless AllowHttp.
		     Keycloak: http(s)://<server>:8080/realms/<realm>; Entra ID: https://login.microsoftonline.com/<tenant>/v2.0 -->
		<add key="Issuer" value="https://demo.duendesoftware.com"/>

		<!-- Audience (aud claim) the access tokens must carry for this server (Keycloak: audience mapper; Entra ID: exposed API). -->
		<add key="Audience" value="api"/>

		<!-- Public client (authorization code + PKCE) used to obtain the token in the browser, and the scopes requested.
		     Not needed when AccessToken is given. Empty Scope: openid profile email -->
		<add key="ClientId" value="interactive.public"/>
		<add key="Scope" value="openid profile email api"/>

		<!-- Loopback address receiving the provider answer, registered at the provider for ClientId. Empty: http://127.0.0.1:7080/ -->
		<add key="RedirectUri" value=""/>

		<!-- Discovery address. Empty: <Issuer>/.well-known/openid-configuration -->
		<add key="MetadataAddress" value=""/>

		<!-- Isolated site: JSON file of the provider public keys (JWKS), read instead of the discovery. -->
		<add key="JwksFile" value=""/>

		<!-- Client identifiers (azp claim) allowed to present a token, separated by ';'. Empty: any client. -->
		<add key="AllowedClients" value=""/>

		<!-- Scope the token must contain. Empty: not checked. -->
		<add key="RequiredScope" value=""/>

		<!-- Claim giving the AppVision user name. Empty: preferred_username (Keycloak); Entra ID: preferred_username or upn.
		     Duende demo tokens carry "name", not preferred_username. -->
		<add key="UserClaim" value="name"/>

		<!-- Claim listing the groups or roles compared with the OIDCGroup= parameter of the profiles. Empty: groups.
		     Dotted path accepted: realm_access.roles (Keycloak), roles (Entra ID). -->
		<add key="GroupsClaim" value=""/>

		<!-- True: the domain is stripped from the user name (jdupont@plant.local becomes JDUPONT). -->
		<add key="StripDomain" value=""/>

		<!-- Automatic account creation at first sign-in. Empty: the global option App.Main.Authentication.AutoCreate (True by default). -->
		<add key="AutoCreate" value=""/>

		<!-- True: accept an issuer and a discovery over HTTP (test bench only). -->
		<add key="AllowHttp" value=""/>

		<!-- Tolerance on exp and nbf, in seconds. Empty: 120 -->
		<add key="ClockSkew" value=""/>

		<!-- OIDC.Test only: an access token obtained elsewhere (appConfig, Postman, kcadm...) to test without the browser flow.
		     Empty: the token is obtained with the PKCE flow above. -->
		<add key="AccessToken" value=""/>

		<!-- OIDC.Test only, optional: base URL of an AppVision server (http://localhost:8090) to try a real Login with the
		     token (Method=OIDC, Authorization: Bearer) and tell a provider problem from an AppVision one. -->
		<add key="AppVisionUrl" value=""/>
	</appSettings>
</configuration>
