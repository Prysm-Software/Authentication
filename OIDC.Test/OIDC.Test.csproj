<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style project (unlike the three other tools): a classic csproj with PackageReference only resolves its
       packages under Visual Studio's MSBuild, not under `dotnet build`. The target stays .NET Framework 4.8. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>OIDC.Test</RootNamespace>
    <AssemblyName>OIDC.Test</AssemblyName>
    <!-- The Oidc sources are copied verbatim from the appPluginOIDC plugin and rely on modern C#
         (primary constructors, collection expressions). Match the plugin's language level. -->
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- Token validation: same packages and versions as appPluginOIDC (packages.config of the plugin).
       Microsoft.IdentityModel.Protocols.OpenIdConnect brings JsonWebTokens, Tokens, Protocols, Logging and Abstractions. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
