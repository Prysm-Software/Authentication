<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!--
		SAML.Test configuration.
		These keys mirror the AppVision SAML plugin options (App.Main.Authentication.Saml.*).
		Any empty value below will be prompted for interactively when the tool starts.
		-->

		<!-- SP entity id / "application name" declared in the Identity Provider (Issuer). -->
		<add key="IssuerId" value="appvision-saml-test"/>

		<!-- Assertion Consumer Service URL. MUST be an absolute URL the IdP can POST back to,
		     and that this tool can bind an HttpListener to.
		     Use localhost to avoid needing admin rights, e.g. http://localhost:8080/samlv2/acs
		     For a real hostname/IP you must first run (as admin):
		       netsh http add urlacl url=http://+:8080/ user=EVERYONE -->
		<add key="ACSUrl" value="http://localhost:8080/samlv2/acs"/>

		<!-- IdP Single Sign-On endpoint where the AuthnRequest is sent. -->
		<add key="SamlEndPoint" value="https://mocksaml.com/api/saml/sso"/>

		<!-- IdP signing certificate used to validate the SAMLResponse.
		     Either an inline PEM (the BEGIN/END CERTIFICATE block)
		     or a path to a .cer/.pem/.crt file. -->
		<add key="SamlCertificate" value="C:\repos\Authentication\SAML.Test\mocksaml.pem"/>

		<!-- Optional: name of the SAML attribute carrying the user's groups/roles,
		     used by AppVision to map a profile (profile parameter SAMLGroup=xxx). -->
		<add key="GroupsAttributeName" value=""/>
	</appSettings>
</configuration>
